<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.3.2.0</Version>
    <AssemblyVersion>0.3.2.0</AssemblyVersion>
    <FileVersion>0.3.2.0</FileVersion>
    <AssemblyName>PulseQueue.Plugin</AssemblyName>
    <RootNamespace>PulseQueue.Plugin</RootNamespace>
    <Authors>kittenhaswares-ui</Authors>
    <Description>A strict smart input buffer with exact direct-action Turbo and action-only same-slot Macro Turbo.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PulseQueue.Core\PulseQueue.Core.csproj" />
    <Content Include="PulseQueue.Plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
